APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Asset base path ────────────────────────────────────────────────────────
# Leave this UNSET on a normal host. Assets are then absolute URLs built from
# APP_URL, which is correct when APP_URL is the public origin.
#
#   root install       example.com/        -> leave unset
#   sub-directory      example.com/crm/    -> ASSET_URL=/crm
#   preview behind TLS proxy, origin unknown -> ASSET_URL=/
#
# The value must equal the path prefix the app is served from. Getting it wrong
# shows an unstyled page and no error. See docs/DEPLOYMENT_GUIDE.md §4.1.
# ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Session cookie security ─────────────────────────────────────────────
# These three were previously absent from this template, so a deploy that
# copied it silently ran with SESSION_SECURE_COOKIE unset — the session cookie
# would then be sent over plain HTTP. config/session.php reads all three with
# no safe default (`env('SESSION_SECURE_COOKIE')` is null), which means the
# template IS the only place they get set. They are spelled out here so that
# cannot happen again.
#
# DEVELOPMENT (http://localhost, no TLS):
#   SESSION_SECURE_COOKIE=false
# PRODUCTION (behind TLS — required):
#   SESSION_SECURE_COOKIE=true
#
# HttpOnly and SameSite are safe at their defaults in both environments; they
# are listed so a deployer can see them rather than discover them.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CRM Review Environment — leave false in production.
VIRA_REVIEW_ENABLED=false

# The review seeder refuses to create demo accounts without this (min 16 chars).
# Generate one: openssl rand -base64 18.  NEVER commit a real value.
VIRA_REVIEW_DEMO_PASSWORD=

# ── Credential encryption ─────────────────────────────────────────────────
# AES-256-GCM master key for stored project passwords. MUST be different from
# APP_KEY, and MUST NOT be committed or stored in the database.
#
# Generate one with:
#     php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
#
# Leaving this empty does NOT fall back to plaintext: credential storage is
# refused and the UI says so. Losing the key loses every stored credential —
# back this value up separately from the database (OD-29).
VIRA_CREDENTIAL_KEY=

# ── Backup encryption ─────────────────────────────────────────────────────
# AES-256-GCM key for .vbk1 backup containers created by `php artisan vira:backup`.
#
# This is a SEPARATE secret from VIRA_CREDENTIAL_KEY, deliberately. This key
# travels with the backup to off-host storage; the credential key must never
# leave the server. Reusing one value would mean that a leaked backup is also a
# full export of every stored password, and would make it impossible to rotate
# either without breaking the other. See docs/BACKUP_ARCHITECTURE.md §4.
#
# Generate one with:
#     php artisan vira:backup-key
# or: openssl rand -base64 32
#
# Leaving this empty does NOT produce an unencrypted backup: vira:backup refuses
# to run. Losing the key loses every existing backup.
VIRA_BACKUP_KEY=

# Where backup containers are written, relative to storage/app. The default is
# outside the document root and gitignored; do not point it at public/.
VIRA_BACKUP_PATH=backups

# Retention, by age class. Pruning only runs after a backup SUCCEEDS, so a
# failed backup is never the reason the last good one was deleted.
VIRA_BACKUP_KEEP_DAILY=7
VIRA_BACKUP_KEEP_WEEKLY=4
VIRA_BACKUP_KEEP_MONTHLY=6
