# dependencies
/vendor/
/node_modules/

# environment / secrets
.env
.env.*
!.env.example
*.key
!docs/**/*.key

# build artifacts
/public/build
/public/hot
/bootstrap/cache/*.php

# runtime
/storage/*.key
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/private/*
!/storage/app/private/.gitkeep

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# review environment runtime data — a private copy of the database for the
# client review instance. Never production data, never committed.
/database/review/*.sqlite
/database/review/*.sqlite-journal
/database/review/*.sqlite-wal
/database/review/*.sqlite-shm
/database/review/.credentials

# scratch space for one-off diagnostic scripts (never part of the deliverable)
/.arena/

# jupyter/pandas etc not needed
/image-search/

# Delivery artefacts (built ZIPs) — not source, reproduced on demand
/delivery/

# tools/resolve-vendor.py download cache — a development artefact, never shipped.
/.vendor-cache/

# PDF render scratch space (PdfEngine creates and removes it per call; a crashed
# render can leave one behind).
/storage/app/pdf-tmp/
